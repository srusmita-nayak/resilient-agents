# Environment Configuration for Resilient Agents Research Platform
# Copy this file to .env and adjust variables as needed.

# Application Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./backend/resilient_agents.db
SQLITE_TIMEOUT_SECONDS=30.0

# LLM Configuration (Optional - only required for LLM agent runs)
# Safe placeholder: DO NOT commit real keys here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_CALL_BUDGET=50
LLM_TIMEOUT_SECONDS=10.0

# Simulation Limits
MAX_SIMULATED_TIME_DEFAULT=1000.0
MAX_EVENTS_DEFAULT=10000
MAX_WALL_SECONDS_DEFAULT=60.0
